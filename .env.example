# انسخ هالملف باسم .env واملأ القيم 

# --- الداتابيز المحلية (مطابقة لأمر docker) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass

# --- داتابيز سحابية (Neon / Supabase): لو حطيت هالسطر بيُستخدم بدل DB_* اللي فوق ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- الـ LLM: Google Gemini (المفتاح من Google AI Studio) ---
GEMINI_API_KEY=put_the_key_hear
GEMINI_MODEL=gemini-flash-latest

# --- البحث ---
TOP_K=10
TOP_N=5

# --- حماية الواجهة (اختياري، مهم عند النشر العام) ---
# APP_PASSWORD=

# --- Google Drive (اختياري) ---
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
DRIVE_POLL_SECONDS=60
